# =============================================================================
# Veltrox — Environment Variables Template
# Copy this file to `.env.local` and populate with your Firebase credentials.
# NEVER commit `.env.local` or real secrets to source control.
# =============================================================================

# Public Application URL (used for SEO metadata, sitemaps, and auth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Firebase Client SDK (Public Web App Config)
# Found in Firebase Console -> Project Settings -> General -> Your apps
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# -----------------------------------------------------------------------------
# Firebase Admin SDK (Server-Only — Custom Claims, Session Cookies, GDPR Purge)
# Found in Firebase Console -> Project Settings -> Service Accounts -> Generate key
# Tip: Run `npm run import-admin-key -- "<path-to-key.json>"` to populate safely,
# or keep FIREBASE_PRIVATE_KEY wrapped in quotes with \n newline escapes.
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# -----------------------------------------------------------------------------
# Edge Session Signing Secret (Server-Only)
# Generate a random >= 32-byte hex/base64 string, e.g.: `openssl rand -hex 32`
# Used by Next.js Edge Middleware + Server API to sign/verify role session tokens.
# -----------------------------------------------------------------------------
SESSION_SECRET=replace-with-at-least-32-bytes-of-high-entropy-secret

# -----------------------------------------------------------------------------
# Phase 4: Scheduled Reminder Engine & Email Delivery (Optional in Local Dev)
# When RESEND_API_KEY is unset, Veltrox runs a clean simulated delivery adapter.
# Generate CRON_SECRET (>= 16 chars) for Vercel Cron -> GET /api/cron/reminders.
# -----------------------------------------------------------------------------
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL="Veltrox <notifications@veltrox.app>"
CRON_SECRET=replace-with-random-cron-bearer-secret


