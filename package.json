{
  "name": "veltrox",
  "version": "0.1.0",
  "private": true,
  "description": "Veltrox — Digital Car Diary & Smart Garage Management Platform",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "set-admin": "tsx scripts/set-admin.ts",
    "approve-garage": "tsx scripts/approve-garage.ts",
    "import-admin-key": "node scripts/import-service-account.mjs",
    "firebase:doctor": "node scripts/firebase-doctor.mjs",
    "functions:install": "npm --prefix functions install",
    "functions:build": "npm --prefix functions run build",
    "firebase:login": "npx -y firebase-tools@13 login",
    "firebase:emulators": "npx -y firebase-tools@13 emulators:start",
    "firebase:deploy:rules": "npx -y firebase-tools@13 deploy --only firestore:rules,firestore:indexes,storage",
    "firebase:deploy:functions": "npx -y firebase-tools@13 deploy --only functions",
    "firebase:deploy:all": "npx -y firebase-tools@13 deploy --only firestore:rules,firestore:indexes,storage,functions",
    "mobile:sync": "cap sync",
    "mobile:assets": "capacitor-assets generate --android --ios --iconBackgroundColor \"#090d16\" --iconBackgroundColorDark \"#090d16\" --splashBackgroundColor \"#090d16\" --splashBackgroundColorDark \"#090d16\"",
    "mobile:android:debug": "node scripts/build-android.mjs debug",
    "mobile:android:release": "node scripts/build-android.mjs release",
    "mobile:android:all": "node scripts/build-android.mjs all"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^7.5.0",
    "@capacitor/android": "^7.6.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/browser": "^7.0.0",
    "@capacitor/core": "^7.6.0",
    "@capacitor/ios": "^7.6.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "@hookform/resolvers": "^4.1.3",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^11.10.0",
    "firebase-admin": "^13.1.0",
    "framer-motion": "^12.4.7",
    "lucide-react": "^0.475.0",
    "next": "^15.5.0",
    "next-intl": "^4.1.0",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "web-push": "^4.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^7.6.0",
    "@types/node": "^20.17.19",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
